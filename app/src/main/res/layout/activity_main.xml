<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BAEDE6"
    tools:context=".MainActivity" >

    <TextView
        android:id="@+id/textView"
        android:layout_width="183dp"
        android:layout_height="40dp"
        android:text="Agenda Personal"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        android:textColor="@color/black"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="114dp"
        tools:layout_editor_absoluteY="65dp" />

    <ImageButton
        android:id="@+id/id_button"
        android:layout_width="116dp"
        android:layout_height="83dp"
        android:background="@drawable/btn_circulo"
        android:padding="10dp"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/contactos"
        tools:layout_editor_absoluteY="145dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contactos"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="159dp"
        tools:layout_editor_absoluteY="237dp" />

    <ImageButton
        android:id="@+id/btn_agregar"
        android:layout_width="108dp"
        android:layout_height="112dp"
        android:background="@drawable/btn_circulo"
        android:padding="10dp"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.511"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/gt"

        tools:layout_editor_absoluteY="286dp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Añadir contactos"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textSize="16sp"
        tools:layout_editor_absoluteX="147dp"
        tools:layout_editor_absoluteY="398dp" />

    <ImageButton
        android:id="@+id/btn_notas"
        android:layout_width="144dp"
        android:layout_height="98dp"
        android:background="@drawable/btn_circulo"
        android:padding="10dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/notas"
        tools:layout_editor_absoluteX="147dp"
        tools:layout_editor_absoluteY="476dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="notas"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textSize="17sp"
        tools:layout_editor_absoluteX="184dp"
        tools:layout_editor_absoluteY="588dp" />

</androidx.constraintlayout.widget.ConstraintLayout>